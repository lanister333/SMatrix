# ПРОМТ «Временная упрощённая регистрация»:
#   test        — TEST MODE: CAPTCHA → email → аккаунт (SMS не требуется).
#                 Для первых тестирующих и локальной разработки.
#   production  — PRODUCTION MODE: CAPTCHA → SMS → email → аккаунт.
#                 SMS-код обязателен и не возвращается API.
# По умолчанию (если переменная не задана) — test.
REGISTRATION_MODE=test
