# «Театр ботов» v2 — biz65.ru → Z.ai → sakhmatrix.ru
# Полностью автономный. Без Telegram. Прямая публикация на сайт.
#
# Переменные окружения:
#   ZAI_API_KEY — ключ Z.ai
#   SAKHMATRIX_API_URL — URL API (http://127.0.0.1:3000/api/theatre-bots/publish)
#   SAKHMATRIX_API_TOKEN — shared secret (THEATRE_BOTS_TOKEN)
#   TELEGRAM_BOT_TOKEN — токен бота для уведомлений (опционально)
#   TELEGRAM_CHAT_ID — ID чата для уведомлений (опционально)
#
# .env для скрипта:
#   ZAI_API_KEY=ваш_ключ
#   SAKHMATRIX_API_URL=http://127.0.0.1:3000/api/theatre-bots/publish
#   SAKHMATRIX_API_TOKEN=sakhmatrix-theatre-2026
ZAI_API_KEY=758914c6dcea4ab89b701f31d078b48a
SAKHMATRIX_API_URL=http://127.0.0.1:3000/api/theatre-bots/publish
SAKHMATRIX_API_TOKEN=sakhmatrix-theatre-2026
